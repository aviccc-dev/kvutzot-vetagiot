        </outline>
        <outline text="הסדר הפרטי">
          <kvInfo kind="user" name="הגדרה">הפרטי הוא שידריך את האדם אל ידיעת איזה משכל מן המשכלות בפרט, ויתחלק להמצאה והבחנה.</kvInfo>
          <kvInfo kind="user" name="מקור">פרק כג, ה–כו</kvInfo>
          <outline text="ההמצאה">
            <kvInfo kind="user" name="הגדרה">ההמצאה הוא - המצאת הגזרות וההקשים שנתבארו חקותיהם למעלה.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק כג, ו–כה</kvInfo>
            <kvInfo kind="user" name="הערה">הסקה של Claude: "הבחנת הגזרה" (ט–כה) — תחת ההמצאה, כי הספר כותב אחריה "עד עתה בארנו ההמצאה" (כו).</kvInfo>
            <outline text="המצאת הגזרות">
              <kvInfo kind="user" name="הגדרה">המצאת הגזרות הוא - הבחן בנושא מן הנושאים אחת מן ההבחנות הכ"א שנתבארו למעלה.</kvInfo>
              <kvInfo kind="user" name="פירוש">כבר בארנו למעלה, איך הכ"א הבחנות אלה הם כלל כל מה שיש לקים או לשלל באיזה נושא שיהיה, ומזה נבנות הגזרות שאינם אלא קיום או שלילת מה בנושא.</kvInfo>
              <kvInfo kind="user" name="סדר החקירה">1 השם אם הוא מיחד, או משתף, או משאל, וכיוצא משאר מיני השם. 2 הסוג. 3 הסבות כלם. 4 המסבבים היותר רשומים. 5 המתחברים, המיחדים, המשתפים, הקודמים והנמשכים וכל השאר. 6 הגדר. 7 החלוק בחלקים בניניים, אם הנושא כל בניניי. 8 החלוק במינים אם הנושא סוג. 9 הנערכים בכל חלקיהם. 10 המשתנים וההפכיים בכל חלקיהם, שגם ידיעתם מועלת הרבה לברור ידיעת הנושא.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק כג, ז</kvInfo>
            </outline>
            <outline text="המצאת ההקשים">
              <kvInfo kind="user" name="הגדרה">המצאת ההקשים הוא המצאת המופתים להאמתת הגזרות, או להכחשתן, ומקורה הכ"א הבחנות שבארנו.</kvInfo>
              <kvInfo kind="user" name="דוגמה">כל מה שיתיחס אל הבורא יתברך ראוי לכבדו כבוד גדול, התורה מתיחסת לבורא יתברך, אם כן ראוי לכבדה כבוד גדול.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק כג, ח</kvInfo>
            </outline>
            <outline text="הבחנת הגזרה">
              <kvInfo kind="user" name="הגדרה">הבחנת הגזרה, לאמתה או להכחישה. תהיה או בפני עצמה, או בוכוח.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק כג, ט–כה</kvInfo>
              <outline text="בפני עצמה">
                <kvInfo kind="user" name="הגדרה">בפני עצמה הוא - שנבחן גזרה אחת לבדנו, בלי מתנגד, על ידי הבחנות הנאותות.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק כג, ט</kvInfo>
              </outline>
              <outline text="בוכוח">
                <kvInfo kind="user" name="הגדרה">בוכוח הוא - כשתאמרנה שתי גזרות שונות או הפכיות ונערך ביניהם מלחמה על ידי הקשים שיעזרו לאחת מהם, או לחברתה, ויהיה ההשתדלות לסתר ההקשים המטעים ולהעמיד האמתיים, עד שתקים הגזרה האמתית, וזה יעשה או בוכוח מדמה או בוכוח גופיי.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק כג, י–כה</kvInfo>
                <outline text="הוכוח המדמה">
                  <kvInfo kind="user" name="הגדרה">הוכוח המדמה הוא - שאיש אחד יעשה פעלת השני, דהינו שיגזר גזרתו באמת, ואחר כך יקשה עליה בהקשים יכזיבוה, אחר כך יסתר ההקשים ההם, ויקים גזרתו ויראה אמתה.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק כג, יא</kvInfo>
                </outline>
                <outline text="הוכוח הגופיי">
                  <kvInfo kind="user" name="הגדרה">הוכוח הגופיי הוא - שיהיה בין שני גופים ממש, אחד מניח ואחד מקשה, ויבחנו בזה ארבע הבחנות: ראשונה - הנושא, שניה - האפן, שלישית - המתוכחים, רביעית - התכלית.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק כג, יב–כה</kvInfo>
                  <outline kvDivision="yes" text="ארבע ההבחנות שבוכוח" kvAspect="b42">
                    <outline text="נושא הוכוח">
                      <kvInfo kind="user" name="הגדרה">הנושא הוא הענין או גזרה, שעליו ישאו ויתנו המקשה והמשיב.</kvInfo>
                      <kvInfo kind="user" name="פירוש">המשא ומתן הוכוחי אין ראוי שיהיה אלא בענין שאמתו בלתי מפרסמת, כי במפרסמות אינו אלא מיתר ובענין שידיעתו אפשרית, כי בנמנעי ההשגה המשא ומתן בטל ומיתר ובלתי ראוי; ושיהיה ענין שידיעתו מועלת לאיזה חכמה או מלאכה, שאם לא כן אינו אלא שיחה בטלה.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק כג, יג</kvInfo>
                    </outline>
                    <outline text="אפן הוכוח">
                      <kvInfo kind="user" name="הגדרה">האפן הוא - שיהיה המשא ומתן ברור, בלי הטעאות; שיהיה בישוב ובנחת, בלי בהלה וכעס; שיהיה בדרך קצרה והגיונית.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק כג, יד</kvInfo>
                    </outline>
                    <outline text="המתוכחים">
                      <kvInfo kind="user" name="הגדרה">המתוכחים הם - האחד המניח והוא עצמו המשיב, והשני - המקשה לו.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק כג, טו–כג</kvInfo>
                      <outline text="המניח (המשיב)">
                        <kvInfo kind="user" name="הגדרה">המניח צריך שיבאר גזרתו היטב בדרך קצרה, ולא יותר מדאי, ולא יגזר לחיוב אלא מה שיכרח לו על פי הקש אמתי.</kvInfo>
                        <kvInfo kind="user" name="פירוש">משא המשיב הוא קדם השיבו ובעת השיבו. קדם השיבו - להאזין היטב אל הקשיא ולהבחין ענינה: אם באמת מתנגד הוא להנחתו אם לא, אם בנינה הגיוני אם לא, אם הקדמותיה ותולדתה מכרחות אם לא.</kvInfo>
                        <kvInfo kind="user" name="מקור">פרק כג, טז, כג</kvInfo>
                      </outline>
                      <outline text="המקשה">
                        <kvInfo kind="user" name="הגדרה">משא המקשה הוא במה שקדם הקשותו, בעת הקשותו, ואחרי הקשותו.</kvInfo>
                        <kvInfo kind="user" name="מקור">פרק כג, יז–כב</kvInfo>
                        <outline text="קדם הקשותו">
                          <kvInfo kind="user" name="הגדרה">קדם הקשותו הוא - האזן היטב להנחת המניח בכל חלקיה, להבין אותה כהגן, אחר כך דקדק בהם אם יש להתנגד לאחד מהם, אם בדחיה אם בסתירה.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק כג, יח–כ</kvInfo>
                          <outline text="דחיה">
                            <kvInfo kind="user" name="הגדרה">בדחיה הוא - כשיעדר ההכרח בגזרתו של המניח, אפילו אם לא יכחישה.</kvInfo>
                            <kvInfo kind="user" name="מקור">פרק כג, יט</kvInfo>
                          </outline>
                          <outline text="סתירה (בוכוח)">
                            <kvInfo kind="user" name="הגדרה">בסתירה הוא - בהיות גזרתו כוזבת, מכח הקש חזק שיסתר אותה.</kvInfo>
                            <kvInfo kind="user" name="מקור">פרק כג, כ</kvInfo>
                          </outline>
                        </outline>
                        <outline text="בעת הקשותו">
                          <kvInfo kind="user" name="הגדרה">בעת הקשותו - שיסדר קשיתו בדרך קצרה והגיונית, לפי מה שהיא, אם דחיה ואם סתירה.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק כג, כא</kvInfo>
                        </outline>
                        <outline text="אחרי הקשותו">
                          <kvInfo kind="user" name="הגדרה">אחרי הקשותו - האזן היטב אל המניח שישיב אל קשיתו, והודות על האמת.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק כג, כב</kvInfo>
                        </outline>
                      </outline>
                    </outline>
                    <outline text="תכלית הוכוח">
                      <kvInfo kind="user" name="הגדרה">התכלית יתחלק לעקרי וטפל.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק כג, כד–כה</kvInfo>
                      <outline kvDivision="yes" text="עקרי וטפל" kvAspect="b8">
                        <outline text="התכלית העקרי (בוכוח)">
                          <kvInfo kind="user" name="הגדרה">העקרי - השגת האמת</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק כג, כה</kvInfo>
                        </outline>
                        <outline text="התכלית הטפל (בוכוח)">
                          <kvInfo kind="user" name="הגדרה">הטפל - חדוד השכל.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק כג, כה</kvInfo>
                        </outline>
                      </outline>
                    </outline>
                  </outline>
                </outline>
              </outline>
            </outline>
          </outline>
          <outline text="ההבחנה (בסדר)">
            <kvInfo kind="user" name="הגדרה">ההבחנה, והיא - הבחן חלקי המאמרים והעמידם על מדרגותיהם ההגיוניות.</kvInfo>
            <kvInfo kind="user" name="פירוש">אחר שידענו מה נשלל או נחיב באחד מן הנושאים וההקשים המוכיחים אמתת גזרה מן הגזרות, מזה נבנה הדרושים וההגדות במליצה כראוי… אך לבחינת הדרושים - נצטרך לנתחם, ולהבדיל עניני המליצה ודרכי הספור לבד והחלקים ההגיונים לבד</kvInfo>
            <kvInfo kind="user" name="סדר המעשה">תחלת הכל צריך שתקרא ותשנה ותשלש הדרוש או ההגדה אשר תרצה לנתח, ותתבונן בה היטב עד שתכיר ענינה, אם הוא אחד או יותר, אם הוא פשוט או מחבר.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק כג, כו</kvInfo>
          </outline>
        </outline>
      </outline>
    </outline>

  <body>
    <outline text="מלאכת ההגיון">
      <kvInfo kind="user" name="הגדרה">כל עמל השכל והשתדלותו הוא להשיג הדברים לאמתם. אמנם, יש שיקרה לו לטעות בהן ויהיה מה שישיג מהן כוזב, על כן יצטרך לו למוד לדעת להכיר מקומות המכשול שאפשר לו לכשל בם וידע איך ישמר מהם עד שתהיה השגתו אמתית. וכלל הלמוד הזה הוא הנקרא מלאכת ההגיון.</kvInfo>
      <kvInfo kind="user" name="מקור">פרק א, א</kvInfo>
      <kvInfo kind="user" name="הערה">החלוקה הראשונה — של המשתמש (10.11.2026): עסק ההגיון, ההגיון עצמו, הסדר. שאר החלוקות — לפי הספר. מה שמסומן "הסקה של Claude" — החלטה שלי על המבנה. שמות הבחינות לקוחים ממילות הספר בחלוקה; כשהספר מחלק באותו זוג מילים במקומות שונים (למשל רחוק וקרוב, עקרי וטפל, פשוט ומרכב) — נתתי שם אחד, כדי שבתצוגת הבחינות ייראה איפה כל בחינה חוזרת. גם "עצמי ומקרי" אוחד: מתחבר (עצמי ומקרי), צורה (עצמית ומקרית), כל (מצד עצמו ומקריי), פועל (מצד עצמו ובמקרה) — הסקה של Claude, אפשר לפצל.</kvInfo>
      <outline text="עסק ההגיון">
        <kvInfo kind="user" name="פירוש">עד הנה בארנו עסק ההגיון; עתה נבאר חלוקו למחלקותיו (פרק ד, א)</kvInfo>
        <kvInfo kind="user" name="מקור">פרקים א–ג</kvInfo>
        <kvInfo kind="user" name="הערה">הסקה של Claude: סדר הבנים כאן לפי סדר הספר. "ההבחנה" (פרק א, ב–ג) — בראש, כי הספר פותח בה.</kvInfo>
        <outline text="ההבחנה">
          <kvInfo kind="user" name="הגדרה">עקר מלאכת השכל בבקשתו ידיעת הדברים הוא ההבחנה עד שיכיר כל דבר ודבר בפני עצמו נבחן ונבדל מכל זולתו.</kvInfo>
          <kvInfo kind="user" name="פירוש">אמנם בהיות שכלל המציאיות יש בהם מה שדומה האחד לזולתו ויש בהם מה שנבדל האחד מזולתו, על כן לא יגיע השכל לסוף מלאכתו עד שישתלם בשתי הפעלות, שהם: הדמיון וההבדל.</kvInfo>
          <kvInfo kind="user" name="פירוש">בכל אחד משתי הפעלות יכול לפל הטעות אם ידמה מה שאינו דומה, או יבדיל מה שלא נבדל. על כן לשתיהן צריך למוד ואמון וחקים מסדרים, שיעמידוהו בנתיב הישר ולא ישגה ממנו, עד שישיג תכליתו על נכון.</kvInfo>
          <kvInfo kind="user" name="מקור">פרק א, ב–ג</kvInfo>
          <outline kvDivision="yes" text="שתי הפעלות" kvAspect="b1">
            <outline text="הדמיון">
              <kvInfo kind="user" name="מקור">פרק א, ב</kvInfo>
            </outline>
            <outline text="ההבדל">
              <kvInfo kind="user" name="מקור">פרק א, ב</kvInfo>
            </outline>
          </outline>
        </outline>
        <outline text="כלל המציאיות">
          <kvInfo kind="user" name="הגדרה">כלל המציאיות יתחלק לשני חלקים. הראשון: מרגש או מוחש; והשני: משכל.</kvInfo>
          <kvInfo kind="user" name="מקור">פרק א, ד</kvInfo>
          <outline text="המרגש (המוחש)">
            <kvInfo kind="user" name="הגדרה">המרגש הוא שמשג מן אחד החושים</kvInfo>
            <kvInfo kind="user" name="דוגמה">המוחש הוא, דרך משל, האבן והעץ, שרואים אותו בחוש</kvInfo>
            <kvInfo kind="user" name="מקור">פרק א, ד</kvInfo>
          </outline>
          <outline text="המשכל">
            <kvInfo kind="user" name="הגדרה">המשכל הוא אשר ידמהו השכל בדמיונו, אך אין מציאותו כן חוץ ממנו, ויחלק גם הוא לשנים, האחד מפרד והאחד מדמה.</kvInfo>
            <kvInfo kind="user" name="דוגמה">והמשכל - כגון החכמה, הזכרון, הגבורה, שהם דברים שמשכילים ומצירים אותם בשכל, אך אין החוש רואה אותם.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק א, ד</kvInfo>
            <outline text="המפרד">
              <kvInfo kind="user" name="הגדרה">המפרד הוא - שמה שאינו משג מן החושים אלא בחבור עם זולתו, יפרידהו השכל בדמיונו ויקחהו לבדו.</kvInfo>
              <kvInfo kind="user" name="דוגמה">המראה, דהינו הלבן והשחרות ושאר הגונים אין החוש רואה אותם לבדם אלא נתונים באחד מן הגופים, אך השכל מציר הלבן היותו ענין אחד נוסף על הגוף שהוא בתוכו, ונקרא שמפרידו בדמיונו מן הגוף שהוא נתון בו וזהו המפרד</kvInfo>
              <kvInfo kind="user" name="מקור">פרק א, ה</kvInfo>
            </outline>
            <outline text="המדמה">
              <kvInfo kind="user" name="הגדרה">המדמה הוא - אשר אינו משג מן החושים כלל לא לבדו ולא בחבור אלא השכל הוא אשר ידמה אותו, ויתחלק גם הוא לשנים, הראשון משג והשני בדוי.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק א, ה</kvInfo>
              <outline text="המשג">
                <kvInfo kind="user" name="הגדרה">המשג הוא הדבר שאף על פי שאין מציאותו הוה במה שמוחש, ראוי למצא לפי ההדרגה, ונמשך המוחש אחריו בסדר</kvInfo>
                <kvInfo kind="user" name="פירוש">המשג הוא - שממה שאנו רואים בחוש אנחנו דנים על מציאות שאין אנו רואים.</kvInfo>
                <kvInfo kind="user" name="דוגמה">אנו רואים שיש בני אדם והם חיים, בהמות וגם הם חיים, עופות וגם הם כך, נאמר שיש מין אחד של בריאה בין הבריאות שנקרא מין הבעלי חיים, ואין המין הזה דבר הוה ממש זולת אלה הפרטים שלו שזכרנו</kvInfo>
                <kvInfo kind="user" name="מקור">פרק א, ו</kvInfo>
              </outline>
              <outline text="הבדוי">
                <kvInfo kind="user" name="הגדרה">והבדוי הוא אשר איננו לא הוה ולא ראוי ולא המוחש נמשך אחריו בסדר.</kvInfo>
                <kvInfo kind="user" name="פירוש">מה שאין כן הבדוי, שהוא דמיון לבד, ואין דבר במוחש שנדון ממנו היות הבדוי ההוא.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק א, ו</kvInfo>
              </outline>
            </outline>
          </outline>
        </outline>
        <outline text="המשגים">
          <kvInfo kind="user" name="הגדרה">כל משג הוא או עצם או מקרה.</kvInfo>
          <kvInfo kind="user" name="פירוש">בין המשגים המוחשים והמשכלים שנתבארו למעלה.</kvInfo>
          <kvInfo kind="user" name="פירוש">אלה העשרה כללי ענינים שזכרנו - אחד עצם ותשעה מקרים - תחתיהם נכללים כל עניני המציאות למדרגותיהם.</kvInfo>
          <kvInfo kind="user" name="מקור">פרק ב, א–ב; פרק ג, כג</kvInfo>
          <outline text="עצם">
            <kvInfo kind="user" name="הגדרה">עצם - הוא הדבר הממשיי שעמידתו בעצמו ולא באחר, ובו עומדים המקרים המתחברים לו.</kvInfo>
            <kvInfo kind="user" name="דוגמה">עצם האבן, העץ, הבעל־חיים וכל הנמצאים רוחנים וגשמים.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק ב, ג</kvInfo>
          </outline>
          <outline text="מקרה">
            <kvInfo kind="user" name="הגדרה">מקרה - הוא ענין ימצא בעצם ועומד בו, ולא יעמד זולת עצם.</kvInfo>
            <kvInfo kind="user" name="דוגמה">המראה שזכרנו למעלה, היפי, החכמה שאינם נמצאים בפני עצמם, אלא נתונים באחד מן העצמים.</kvInfo>
            <kvInfo kind="user" name="כלל">מציאות המקרה הוא התחבר לעצם. (פרושו: כי הנה המקרה אינו אלא ענין היות בעצם, בחינה אחת או בחינות רבות נוספות על היותו עצם.)</kvInfo>
            <kvInfo kind="user" name="כלל">המקרה תלוי בעצם בין בהויה בין במציאות.</kvInfo>
            <kvInfo kind="user" name="כלל">מקרה מבלתי עצם נמנע.</kvInfo>
            <kvInfo kind="user" name="כלל">המקרה לא יתגלגל מנושא לנושא או מעצם לעצם.</kvInfo>
            <kvInfo kind="user" name="פירוש">אשר היות הבחינה ההיא נמצאת בעצם זהו המקרה שקרה לעצם.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק ב, ד; פרק ג</kvInfo>
            <outline kvDivision="yes" text="חלקי המקרה" kvAspect="b2">
              <outline text="כמות">
                <kvInfo kind="user" name="הגדרה">כמות הוא מקרה ישער בו הדבר ובעבורו ישאל כמה, ויתחלק לשני חלקים: האחד - המדה שקראוה כמות דבק. והשני - המספר שקראוהו כמות נפרד.</kvInfo>
                <kvInfo kind="user" name="פירוש">כי רבוי החלקים והדבקם זה לזה עושים גוף בעל שעור שיוכל למדד, וזה מה שכונו באמרם: כמות דבק. ורבוים בפרוד זה מזה מוליד המספר, וזה מה שכונו בקראם אותו: כמות נפרד.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, ג</kvInfo>
                <outline text="המדה (כמות דבק)">
                  <kvInfo kind="user" name="מקור">פרק ג, ג</kvInfo>
                </outline>
                <outline text="המספר (כמות נפרד)">
                  <kvInfo kind="user" name="מקור">פרק ג, ג</kvInfo>
                </outline>
              </outline>
              <outline text="איכות">
                <kvInfo kind="user" name="הגדרה">איכות - מקרה, בו יאמר על הדבר מה ואיך, יתחלק לארבעה מינים: הקנין וההכנה הטבעית. התכונה והצורה.</kvInfo>
                <kvInfo kind="user" name="כלל">באיכות שיך פחות ויתר.</kvInfo>
                <kvInfo kind="user" name="כלל">בין האיכיות יש הפכיות. (דרך משל: חם וקר.)</kvInfo>
                <kvInfo kind="user" name="כלל">מצד האיכות יאמר בדברים דומים ולא דומים.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, ד</kvInfo>
                <outline text="הקנין (באיכות)">
                  <kvInfo kind="user" name="הגדרה">הקנין הוא איכות אחד באדם, שעל ידו הוא ראוי לאיזה פעלות. ויתחלק לשלשה מינים: עיוני, מעשיי ומלאכותיי.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ג, ה</kvInfo>
                  <outline text="העיוני">
                    <kvInfo kind="user" name="הגדרה">העיוני הוא מה שענינו ידיעה והשגה, ומיניו שלשה: הטבע, ומה שאחר הטבע, והתכונות.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, ו</kvInfo>
                    <outline text="הטבע">
                      <kvInfo kind="user" name="הגדרה">הטבע הוא ידיעת הדברים הטבעיים בבחינת טבעיים ומשג מהחושים</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ג, ז</kvInfo>
                    </outline>
                    <outline text="מה שאחר הטבע">
                      <kvInfo kind="user" name="הגדרה">מה שאחר הטבע - ידיעת הדברים שלמעלה מכל החושים ולא משגים מהם.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ג, ז</kvInfo>
                    </outline>
                    <outline text="התכונות">
                      <kvInfo kind="user" name="הגדרה">התכונות - נכללים בהם חכמת הגלגלים, התשברת, ההנדסה, המבט, הנגון, וכיוצא.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ג, ז</kvInfo>
                    </outline>
                  </outline>
                  <outline text="המעשיי">
                    <kvInfo kind="user" name="הגדרה">המעשיי הוא ידיעת תקון מעשה, ומתחלק לשלשה מינים, והם: המוסר, המדינות, והפרנסה.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, ח</kvInfo>
                    <outline text="המוסר">
                      <kvInfo kind="user" name="מקור">פרק ג, ח</kvInfo>
                    </outline>
                    <outline text="המדינות">
                      <kvInfo kind="user" name="מקור">פרק ג, ח</kvInfo>
                    </outline>
                    <outline text="הפרנסה">
                      <kvInfo kind="user" name="מקור">פרק ג, ח</kvInfo>
                    </outline>
                  </outline>
                  <outline text="המלאכתיי">
                    <kvInfo kind="user" name="הגדרה">המלאכתיי הוא ידיעת מלאכה אחת, ומתחלק לשנים: מלאכות חפשיות. והשני - הלא חפשיות.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, ט</kvInfo>
                    <outline text="המלאכות החפשיות">
                      <kvInfo kind="user" name="הגדרה">החפשיות הם הראויות לשרים ונכבדים, והם שלשה: דקדוק, הלצה, הגיון.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ג, י</kvInfo>
                      <outline text="דקדוק">
                        <kvInfo kind="user" name="מקור">פרק ג, י</kvInfo>
                      </outline>
                      <outline text="הלצה">
                        <kvInfo kind="user" name="מקור">פרק ג, י</kvInfo>
                      </outline>
                      <outline text="הגיון">
                        <kvInfo kind="user" name="מקור">פרק ג, י</kvInfo>
                      </outline>
                    </outline>
                    <outline text="המלאכות הלא חפשיות">
                      <kvInfo kind="user" name="הגדרה">הלא החפשיות הן הבלתי ראויות לשרים ונכבדים</kvInfo>
                      <kvInfo kind="user" name="דוגמה">כגון: התפירה, הבנין, האריגה וכיוצא.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ג, י</kvInfo>
                    </outline>
                  </outline>
                </outline>
                <outline text="ההכנה הטבעית">
                  <kvInfo kind="user" name="הגדרה">ההכנה הטבעית הנמצא בנושא מצד טבעו</kvInfo>
                  <kvInfo kind="user" name="דוגמה">כגון: חדוד השכל והזכרון, חזק הגוף ובריאותו, קלות התנועה.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ג, יא</kvInfo>
                </outline>
                <outline text="התכונה">
                  <kvInfo kind="user" name="הגדרה">התכונה היא מה שבתכן הדבר ומזגו, ותתחלק לשנים: האחד - ראשונית, והשני - שנית.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ג, יב</kvInfo>
                  <outline text="התכונה הראשונית">
                    <kvInfo kind="user" name="הגדרה">הראשונית מתחלק לארבעה, והם: החם והקר, הלחות והיבש</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, יג</kvInfo>
                  </outline>
                  <outline text="התכונה השנית">
                    <kvInfo kind="user" name="דוגמה">והשנית - כגון: הקשי והרך, הקלות והכבד, וכיוצא.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, יג</kvInfo>
                  </outline>
                </outline>
                <outline text="הצורה (באיכות)">
                  <kvInfo kind="user" name="הגדרה">הצורה היא צורת הדבר שבה נראה ומצטיר בשכל, ומתחלקת לשתים: האחת - טבעית, והשניה - מלאכתית.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ג, יד</kvInfo>
                  <outline text="הצורה הטבעית">
                    <kvInfo kind="user" name="דוגמה">הטבעית - צורת האדם, צורת הסוס, וכן שאר המינים</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, טו</kvInfo>
                  </outline>
                  <outline text="הצורה המלאכתית">
                    <kvInfo kind="user" name="הגדרה">המלאכתית - צורת הנעשה בידי אדם.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, טו</kvInfo>
                  </outline>
                </outline>
              </outline>
              <outline text="פעלה">
                <kvInfo kind="user" name="הגדרה">פעלה היא התעוררות העצם או גלוי ויציאת כח הפועל שבעצם. (או תאמר: המשך המסבב מן הסבה הפועלת, וכמו שנכתוב לקמן).</kvInfo>
                <kvInfo kind="user" name="דוגמה">החמום הוא המשך החם מהאש</kvInfo>
                <kvInfo kind="user" name="כלל">כל פועל ברצון פועל לתכלית מה.</kvInfo>
                <kvInfo kind="user" name="כלל">בפעלות יש פחות ויתר.</kvInfo>
                <kvInfo kind="user" name="כלל">בפעלה שיך הפכיות. (דרך משל: מחמם - מקרר.)</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, טז</kvInfo>
              </outline>
              <outline text="הפעל">
                <kvInfo kind="user" name="הגדרה">ההפעל הוא רשם הפעלה.</kvInfo>
                <kvInfo kind="user" name="כלל">בהפעל יש פחות ויתר.</kvInfo>
                <kvInfo kind="user" name="כלל">בהפעל שיך הפכיות.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, יז</kvInfo>
              </outline>
              <outline text="יחס">
                <kvInfo kind="user" name="הגדרה">יחס הוא מין קשר בין שני דברים, בעבורו יאמר באחד מהם שהוא של חברו.</kvInfo>
                <kvInfo kind="user" name="פירוש">כגון אב שהוא ענין מתיחס אצל בן ובן הוא ענין מתיחס אצל אב. כי אין אב אלא שיש לו בן ואין בן אלא שיש לו אב.</kvInfo>
                <kvInfo kind="user" name="כלל">מקרה היחס גובר ברבויו בכל המקרים.</kvInfo>
                <kvInfo kind="user" name="כלל">שני המתיחסים שוים בהכרח בהעדר ובמציאות. (פרושו: בהמצא אחד, מציאות השני מכרח. וכן בהעדר האחד, מכרח בטול השני.)</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, יח</kvInfo>
              </outline>
              <outline text="זמן">
                <kvInfo kind="user" name="הגדרה">זמן - מקרה זמניי בעצם, דהינו: שעור מרחקו מן התחלה או הסוף.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, יט</kvInfo>
              </outline>
              <outline text="מצב">
                <kvInfo kind="user" name="הגדרה">מצב - מקרה מצבי בעצם.</kvInfo>
                <kvInfo kind="user" name="פירוש">אפן המצא חלקי העצם במקום - זהו הנקרא מצב, כגון העמידה, הישיבה, הנטיה, וכיוצא.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, כא</kvInfo>
              </outline>
              <outline text="קנין">
                <kvInfo kind="user" name="הגדרה">קנין - מקרה מורה מין קניה נקנית בעצם. או הלבשה עליו.</kvInfo>
                <kvInfo kind="user" name="דוגמה">המלבושים שעל האדם, או המדות הקנויות בנפשו - הענוה, הנדיבות, וכיוצא.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, כב</kvInfo>
              </outline>
              <outline text="אנה">
                <kvInfo kind="user" name="הגדרה">אנה - מקרה מקומי בעצם, דהינו: החלק מן העולם שממלא ממנו.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, כ</kvInfo>
              </outline>
            </outline>
          </outline>
        </outline>
        <outline text="הנדרשים בעשרה הענינים">
          <kvInfo kind="user" name="הגדרה">והנדרשים בעשרה הענינים שזכרנו - שנים, והם: הפרטים והכוללים.</kvInfo>
          <kvInfo kind="user" name="מקור">פרק ג, כד</kvInfo>
          <outline text="הפרטים">
            <kvInfo kind="user" name="הגדרה">הפרטים הם הנמצאים כל אחד בפני עצמו, כגון: איש מן האנשים, עוף מן העופות, אילן מן האילנות, וכיוצא בזה, ונקראים אישים.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק ג, כה</kvInfo>
          </outline>
          <outline text="הכוללים">
            <kvInfo kind="user" name="הגדרה">הכוללים - שנים, ראשון: כוללי המציאות, והשני: משיגיהם.</kvInfo>
            <kvInfo kind="user" name="מקור">פרק ג, כו</kvInfo>
            <outline text="כוללי המציאות">
              <kvInfo kind="user" name="הגדרה">כוללי המציאות גם הם שנים, הראשון - סוג, והשני - מין.</kvInfo>
              <kvInfo kind="user" name="פירוש">הסוג והמין ענינם אחד, והוא כלל כולל פרטים מצד שתוף שהם משתפים בענין אחד. וההפרש שבין הסוג והמין שמה שכולל יותר - יקרא סוג, ומה שאינו כולל אלא מקצת ממה שנכלל בסוג - יקרא מין.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ג, כז–כח</kvInfo>
              <outline text="סוג">
                <kvInfo kind="user" name="הגדרה">מה שכולל יותר - יקרא סוג</kvInfo>
                <kvInfo kind="user" name="דוגמה">בעלי חיים הוא סוג, כי נכללים בזה החיות והעופות, הדגים ובני אדם מצד השתוף שיש ביניהם בענין החיות, שכלם חיים.</kvInfo>
                <kvInfo kind="user" name="כלל">הסוג גדול מכל מין ומין שתחתיו. (פרושו: כי הסוג הוא מה שכולל מינים הרבה.)</kvInfo>
                <kvInfo kind="user" name="כלל">הסוג אינו מתפרד ממיניו. (פרושו: כי אין הסוג אלא החק הכללי השוה למיניו, ונמצא שאי אפשר לשום מין להיות בלא החק הזה.)</kvInfo>
                <kvInfo kind="user" name="כלל">מה שיקרה לסוג יקרה לכל מין.</kvInfo>
                <kvInfo kind="user" name="כלל">כשינח סוג ינחו בהכרח מינים, ובהעדר הסוג נעדרים כלם.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, כח–לא</kvInfo>
                <outline kvDivision="yes" text="לעליון או אמצעי" kvAspect="b3">
                  <outline text="סוג עליון">
                    <kvInfo kind="user" name="הגדרה">סוג העליון הוא מה שאין סוג אחר עליו, פרושו: שכולל יותר ממנו</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, ל</kvInfo>
                  </outline>
                  <outline text="סוג אמצעי">
                    <kvInfo kind="user" name="הגדרה">האמצעי הוא שיש סוג כולל ממנו שלגביו יקרא סוג האמצעי - מין, ולגבי המין שתחתיו יקרא סוג.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, ל</kvInfo>
                  </outline>
                </outline>
                <outline kvDivision="yes" text="רחוק וקרוב" kvAspect="b4">
                  <outline text="סוג רחוק">
                    <kvInfo kind="user" name="הגדרה">סוג רחוק הוא - שרחוק מן המין</kvInfo>
                    <kvInfo kind="user" name="פירוש">סוג הסוג הוא רחוק מן המין, כי יש מדרגה אחרת בינו למין.</kvInfo>
                    <kvInfo kind="user" name="דוגמה">התרנגל הוא מין ממיני העופות, עוף הוא סוג למיני העופות, בעלי חיים הוא סוג הסוג לתרנגל ונקרא סוג רחוק, ועוף נקרא סוג קרוב.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, לא</kvInfo>
                  </outline>
                  <outline text="סוג קרוב">
                    <kvInfo kind="user" name="הגדרה">וקרוב - שקרוב לו.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ג, לא</kvInfo>
                  </outline>
                </outline>
              </outline>
              <outline text="מין">
                <kvInfo kind="user" name="הגדרה">ומה שאינו כולל אלא מקצת ממה שנכלל בסוג - יקרא מין.</kvInfo>
                <kvInfo kind="user" name="דוגמה">כלל בני האדם יקרא מין, כי גם הוא כולל כל אישי בני האדם, דהינו: ראובן, שמעון וכו', ואינו כולל החיות והעופות והדגים, שנכללו בשם בעלי חיים.</kvInfo>
                <kvInfo kind="user" name="כלל">המין נולד מהגבל הסוג על ידי איזה הבדלים שבהם נבחן מין ממין אחר. (דרך משל: מסוג הבעלי חיים יולד מין האדם בחבר אליו הבדל הדבור, ונאמר: בעל חי מדבר.)</kvInfo>
                <kvInfo kind="user" name="כלל">המין מאחר בטבע אל סוגו.</kvInfo>
                <kvInfo kind="user" name="כלל">כשינח מין בהכרח ינח הסוג, ובהעדר מין אחד אין העדר הסוג מכרח.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, כח</kvInfo>
              </outline>
            </outline>
            <outline text="משיגי הכוללים">
              <kvInfo kind="user" name="הגדרה">משיגי הכוללים שלשה: הבדל, סגלה ומקרה.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ג, לב</kvInfo>
              <outline text="הבדל">
                <kvInfo kind="user" name="הגדרה">הבדל הוא ענין עצמיי שבו יבחנו זה מזה שנים שיש להם שתוף בסוג או במין. נמצא הסוג והמין מודיעים מעצמות הנמצא מה שישתף בו עם זולתו, וההבדל מודיע ממנו מה שיבדל מזולתו.</kvInfo>
                <kvInfo kind="user" name="דוגמה">האדם והבהמה משתפים בחיות, והבדל האדם מן הבהמה הוא הדבור. ונקרא האדם בעל חי מדבר, והבהמה - בעל חי בלתי מדבר.</kvInfo>
                <kvInfo kind="user" name="כלל">ההבדל הוא ענין עצמי מיחד בסוג או במינו, ונמצא בו ברבו ובכל זמן. (דרך משל: הדבור הוא עצמי למין האדם שזולתו לא היה אדם, ונמצא ברב המין ובכל זמן.)</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, לג</kvInfo>
              </outline>
              <outline text="סגלה">
                <kvInfo kind="user" name="הגדרה">הסגלה הוא הבדל בלתי עצמיי, דהינו שמודיע מהנמצא מה שנבחן בו מזולתו, אך אינו מעצמותו.</kvInfo>
                <kvInfo kind="user" name="דוגמה">השחוק למין האדם, כי אינו נמצא אלא בו, אך אינו מעצמותו, כי אין היותו אדם תלוי בזה, שבלא זה היה אדם.</kvInfo>
                <kvInfo kind="user" name="כלל">הסגלה מיחדת במין או בסוג, ונמצא ברבו ובכל זמן, ואינה עצמית בו.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, לד</kvInfo>
              </outline>
              <outline text="מקרה (במשיגי הכוללים)">
                <kvInfo kind="user" name="הגדרה">המקרה הוא ענין בנמצא בלתי מיחד בו ובלתי עצמי לו.</kvInfo>
                <kvInfo kind="user" name="כלל">המקרה נמצא במעוט הסוג או מין, ולא בכל זמן, ואינו עצמי בו.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ג, לה</kvInfo>
              </outline>
            </outline>
          </outline>
        </outline>
      </outline>
      <outline text="ההגיון עצמו">
        <kvInfo kind="user" name="הגדרה">עד הנה בארנו עסק ההגיון; עתה נבאר חלוקו למחלקותיו, והם שלשה: הראשון - באור השמות, השני - באור המאמרים, השלישי - ההקשים.</kvInfo>
        <kvInfo kind="user" name="פירוש">כי פעלות השכל שלשה. הראשון - השגת הנושאים המזדמנים לפניו כמו שמזדמנים. דרך משל: האבן, העץ, הברזל, וכיוצא.</kvInfo>
        <kvInfo kind="user" name="פירוש">השני - חבר אל נושא מה יחיב בו או ישולל ממנו עד שיבנה מזה המאמר.</kvInfo>
        <kvInfo kind="user" name="פירוש">השלישי הוא - חבר מאמר אל מאמר והוליד מהם שלישי.</kvInfo>
        <kvInfo kind="user" name="פירוש">לפעלה הראשונה משתמש מן השמות, לשני - מן המאמרים, לשלישי - מן ההקשים.</kvInfo>
        <kvInfo kind="user" name="מקור">פרק ד, א</kvInfo>
        <outline text="השמות">
          <kvInfo kind="user" name="הגדרה">השם הוא מורה על אחד מהעצמים או אחד מן המקרים ויתחלק לפי הוראתו ולפי ענינו.</kvInfo>
          <kvInfo kind="user" name="פירוש">כי יש מן השמות שיורו על ענין בדרך פשוט, ויש שיורו בדרך דמיון, ויש שיורו בדרך הסכמה, וכמו שאכתב לפנים. ומצד זה יבחנו השמות לפי הוראתן. אמנם עוד יבחנו השמות מצד הענינים הנרמזים בם</kvInfo>
          <kvInfo kind="user" name="מקור">פרק ד, ב–יא; פרקים ה–טז</kvInfo>
          <outline kvDivision="yes" text="לפי הוראתו" kvAspect="b5">
            <outline text="מיחד">
              <kvInfo kind="user" name="הגדרה">המיחד הוא - שהוא לבדו מורה על ענין אחד לבד</kvInfo>
              <kvInfo kind="user" name="דוגמה">שם העצם, כגון: אברהם, משה, ירושלים.</kvInfo>
              <kvInfo kind="user" name="דוגמה">שם היחס, כגון: עברי, מצרי, וכיוצא.</kvInfo>
              <kvInfo kind="user" name="דוגמה">שם המספר: אחד, שנים.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ד, ג</kvInfo>
            </outline>
            <outline text="נרדף">
              <kvInfo kind="user" name="הגדרה">הנרדף הוא - שיש שמות רבים מורים על ענין אחד, כל אחד מהם נקרא נרדף.</kvInfo>
              <kvInfo kind="user" name="דוגמה">לחם ופת.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ד, ג</kvInfo>
            </outline>
            <outline text="משתף">
              <kvInfo kind="user" name="הגדרה">המשתף הוא שם אחד שמורה על ענינים רבים ומתחלק לשנים: למשתף מחלט ומשתף מתיחס.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ד, ד–ה</kvInfo>
              <outline text="משתף מחלט">
                <kvInfo kind="user" name="הגדרה">משתף מוחלט - הוא שמורה על שני ענינים שאין ביניהם שום יחס ודמיון.</kvInfo>
                <kvInfo kind="user" name="דוגמה">סף שרוצה לומר - כלי, ורוצה לומר - מזוזה.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ד, ה</kvInfo>
              </outline>
              <outline text="משתף מתיחס">
                <kvInfo kind="user" name="הגדרה">משתף מתיחס - שמורה על שני ענינים שיש ביניהם איזה יחס ודמיון, ויתחלק לארבעה: כולל, משאל, מעתק, מודע.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ד, ו–ח</kvInfo>
                <outline text="כולל">
                  <kvInfo kind="user" name="הגדרה">הכולל הוא שם שיורה על ענינים רבים, כל אחד מהם ראוי להם זה השם, כמו שראוי לחברו בשוה, מצד היותם כלם ענפים משרש אחד, והינו המינים שתחת הסוג, והאישים שתחת המין.</kvInfo>
                  <kvInfo kind="user" name="דוגמה">ראובן, שמעון, לוי - כל אחד מהם יקרא אדם, מפני היותם אישים ממין האדם, ונקרא שם אדם - שם כולל.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ד, ו</kvInfo>
                </outline>
                <outline text="משאל">
                  <kvInfo kind="user" name="הגדרה">המשאל הוא שם שיורה על ענין אחד בהוראה ראשונה, ועל ענין אחר בהוראה שניה, מפני שיש לו דמיון מה עם הענין הראשון.</kvInfo>
                  <kvInfo kind="user" name="פירוש">הוראה ראשונה נקראת מה שמשתמשים מהמלה בלשון על הרוב, והוראה שנית - מה שמשתמשים ממנה לפעמים.</kvInfo>
                  <kvInfo kind="user" name="דוגמה">אש, הוראה ראשונה שלו היא על העצם השורף הידוע, ובהוראה שנית יורה על מי שהוא מהיר הרבה בתנועתו ואינו שוקט</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ד, ז</kvInfo>
                </outline>
                <outline text="מעתק">
                  <kvInfo kind="user" name="הגדרה">המעתק הוא שם שיורה על שני ענינים בשוה מפני דמיון שביניהם, עד שלא נוכל לומר על שום אחד מהם היות הוראה שניה בו.</kvInfo>
                  <kvInfo kind="user" name="פירוש">שכבר נהגו כמו כן בלשון שיורה על שני הענינים בשוה.</kvInfo>
                  <kvInfo kind="user" name="דוגמה">הגדר, כך יובן על הגדר הבניניי העשוי סביב השדות, כמו שיובן על באור השלם והציור האמתי אצל ההגיונים.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ד, ח</kvInfo>
                </outline>
                <outline text="מודע">
                  <kvInfo kind="user" name="הגדרה">המודע הוא שם שנאמר על רבים בשוה, וביחוד על אחד, להיות הענין ההוא חזק בו מהאחרים. והדבר מודע לכל, שהכונה בשם ההוא על ענין הפרטי ההוא.</kvInfo>
                  <kvInfo kind="user" name="דוגמה">הגבור סתם יאמר על שמשון, אף על פי ששם זה שיך לכל גבור, לפי שהפליג בגבורה; משורר נאמר על דוד, אף על פי שיש משוררים רבים, לפי שהפליג בשיר.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ד, ח</kvInfo>
                </outline>
              </outline>
            </outline>
          </outline>
          <outline kvDivision="yes" text="לפי הענינים הנרמזים בם" kvAspect="b6">
            <outline text="השמות הדבוריים">
              <kvInfo kind="user" name="הגדרה">הדבוריים הם המשמשים לדבור, להזכיר בם המדבר מה שבמחשבתו מן הענינים הנמצאים</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ד, לפני יא</kvInfo>
            </outline>
            <outline text="השמות הלמודיים">
              <kvInfo kind="user" name="הגדרה">הלמודיים הם המיחדים לחכמות או למלאכות שעל ידיהם מגיעים לתכלית המכון בחכמות או מלאכות ההם, והם כ"ב מינים, כמיני החכמות והמלאכות.</kvInfo>
              <kvInfo kind="user" name="מקור">פרק ד, לפני יא</kvInfo>
              <outline text="השמות המשמשים להגיון">
                <kvInfo kind="user" name="הגדרה">השמות המשמשים להגיון הם אחד ועשרים, ואלה הם: סבה ומסבב, נושא ומתחבר, כל וחלק, גזרה ונגזר, גדר ונגדר, בנין ונבנה, חלוק ונחלק, נערכים, בלתי שוים, הפכיים, עדות ומועד, סוג ומין.</kvInfo>
                <kvInfo kind="user" name="פירוש">כי אלה הם השמות שבהם נגיע לתכלית המכון בהגיון, שהוא לדעת הדברים לאמתם בכל ההבחנות שיש להבחין בהם.</kvInfo>
                <kvInfo kind="user" name="מקור">פרק ד, יא</kvInfo>
                <kvInfo kind="user" name="הערה">הסקה של Claude: ההפכיים — לפי הספר הם מין מ"בלתי שוים" (פרק יד, א), ולכן הם שם תחת בלתי שוים, ולא כאן בנפרד.</kvInfo>
                <outline text="סבה">
                  <kvInfo kind="user" name="הגדרה">הסבה היא הדבר שמכחו נמצא המסבב.</kvInfo>
                  <kvInfo kind="user" name="דוגמה">זריחת השמש ואור היום הוים בזמן אחד. אמנם, בהיות שמציאות אור היום תלוי במציאות זריחת השמש, נקרא לה קודמת, ולאור היום - מאחר בטבע.</kvInfo>
                  <kvInfo kind="user" name="דוגמה">אש שחמם את הברזל, אף אם יכלה האש לא יסור החמום מהברזל, אך לא יולד ממנו חמום אחר.</kvInfo>
                  <kvInfo kind="user" name="כלל">הסבה קודמת למסבבה תמיד לפחות קדימה טבעית. (פרושו, כי הקדימות הן שתים, קדימה זמנית וקדימה טבעית.)</kvInfo>
                  <kvInfo kind="user" name="כלל">אין דבר נמצא בלא סבה שתמציאהו.</kvInfo>
                  <kvInfo kind="user" name="כלל">אין בסבות המשך לאין תכלית. (פרושו, כי הסבה העליונה הוא הבורא, יתברך שמו, אשר אין סבה למעלה ממנו.)</kvInfo>
                  <kvInfo kind="user" name="כלל">אם תנח סבה בפועל ינח המסבב גם כן, אך בהסרתה לא יוסר אלא המסבב, העתיד, לא העבר.</kvInfo>
                  <kvInfo kind="user" name="מקור">פרק ד, יב–יג; פרקים ה–ו</kvInfo>
                  <outline text="הסבה החיצונה">
                    <kvInfo kind="user" name="הגדרה">החיצונה היא שחוץ לעצם המסבב. ותחלק גם כן לשנים, לפועל ותכלית.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ד, יג</kvInfo>
                    <outline text="הפועל">
                      <kvInfo kind="user" name="הגדרה">הפועל הוא שעל ידו הנמצא הוה, ומיניו שנים: פועל מצד עצמו ופועל במקרה.</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ד, יד–כט</kvInfo>
                      <kvInfo kind="user" name="הערה">החלוקה לרחוקה, קרובה וסמוכה — "עוד מתחלקת בכל שאר הסבות" (פרק ד, כו). הסקה של Claude: שמתיה כאן, במקום שהספר מביא אותה.</kvInfo>
                      <outline kvDivision="yes" text="עצמי ומקרי" kvAspect="b7">
                        <outline text="פועל מצד עצמו">
                          <kvInfo kind="user" name="הגדרה">הפועל מצד עצמו הוא הפועל בטבעו או ברצונו, ויתחלק לעקר וטפל.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, טו–כב</kvInfo>
                          <outline kvDivision="yes" text="עקרי וטפל" kvAspect="b8">
                            <outline text="הפועל העקרי">
                              <kvInfo kind="user" name="הגדרה">העקרי - שעקר תלית המסבב בו, ויתחלק לפועל לבדו ופועל בחברה או בשתפות.</kvInfo>
                              <kvInfo kind="user" name="דוגמה">עקר הנהגת העם במלך תחתיו השרים והשוטרים.</kvInfo>
                              <kvInfo kind="user" name="מקור">פרק ד, טז–כ</kvInfo>
                              <outline text="פועל לבד">
                                <kvInfo kind="user" name="הגדרה">הפועל לבד שממציא המסבב לבדו מבלי שיהיה אחר שוה לו בהמצאה זאת.</kvInfo>
                                <kvInfo kind="user" name="פירוש">כי לא ירחיק הפועל לבדו הסבה הכליית. שנבאר לקמן בסיעתא דשמיא, שאינה משתוה לה בהמצאת המסבב, אלא תחתיה היא במדרגה, אך ישלל שיהיה אחר שוה לו בהמצאת המסבב במדרגה אחת.</kvInfo>
                                <kvInfo kind="user" name="מקור">פרק ד, יז</kvInfo>
                              </outline>
                              <outline text="פועל בחברה">
                                <kvInfo kind="user" name="הגדרה">הפועל בחברה הוא אשר יסיע אחר בהמצאת המסבב, בשווי אליו. ויכולים המשתפים להיות שקולים ובלתי שקולים.</kvInfo>
                                <kvInfo kind="user" name="מקור">פרק ד, יח–כ</kvInfo>
                                <outline kvDivision="yes" text="שקולים ובלתי שקולים" kvAspect="b9">
                                  <outline text="שקולים">
                                    <kvInfo kind="user" name="הגדרה">השקולים הם שחלק כל אחד מהם שקול בהמצאת המסבב</kvInfo>
                                    <kvInfo kind="user" name="מקור">פרק ד, יט</kvInfo>
                                  </outline>
                                  <outline text="בלתי שקולים">
                                    <kvInfo kind="user" name="הגדרה">והבלתי שקולים - שאין כל אחד מהם שקול.</kvInfo>
                                    <kvInfo kind="user" name="מקור">פרק ד, יט</kvInfo>
                                  </outline>
                                </outline>
                                <outline kvDivision="yes" text="שתפות מכרח או בלתי מכרח" kvAspect="b10">
                                  <outline text="שתפות מכרח">
                                    <kvInfo kind="user" name="הגדרה">שתפות מכרח הוא כשאין אחד מהם לבדו יכול להמציא מסבבו</kvInfo>
                                    <kvInfo kind="user" name="מקור">פרק ד, כ</kvInfo>
                                  </outline>
                                  <outline text="שתפות בלתי מכרח">
                                    <kvInfo kind="user" name="הגדרה">ובלתי מכרח - שיש כח באחד מהם להמציא מסבבו.</kvInfo>
                                    <kvInfo kind="user" name="מקור">פרק ד, כ</kvInfo>
                                  </outline>
                                </outline>
                              </outline>
                            </outline>
                            <outline text="הסבה הטפלה">
                              <kvInfo kind="user" name="הגדרה">הסבה הטפלה היא שכחה בהמצאת המסבב אינו עקרי, ותחלק למעוררת וכליית.</kvInfo>
                              <kvInfo kind="user" name="מקור">פרק ד, כא–כב</kvInfo>
                              <outline text="המעוררת">
                                <kvInfo kind="user" name="הגדרה">המעוררת היא שמעוררת העקרי לשיפעל.</kvInfo>
                                <kvInfo kind="user" name="דוגמה">תאות הרוח היא המעוררת את הסוחר לטרח בסחורתו</kvInfo>
                                <kvInfo kind="user" name="מקור">פרק ד, כב</kvInfo>
                              </outline>
                              <outline text="הכליית">
                                <kvInfo kind="user" name="הגדרה">הכליית - שמשמשת לפועלת להמציא מסבבה.</kvInfo>
                                <kvInfo kind="user" name="דוגמה">הגרזן לחוצב.</kvInfo>
                                <kvInfo kind="user" name="מקור">פרק ד, כב</kvInfo>
                              </outline>
                            </outline>
                          </outline>
                        </outline>
                        <outline text="פועל במקרה">
                          <kvInfo kind="user" name="הגדרה">הסבה הפועלת במקרה היא, שאין המסבב נולד ממנה לא מטבע ולא מרצון, ותמצא בין בסבות הטבעיות בין בבחיריות.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כז–כט</kvInfo>
                          <outline kvDivision="yes" text="טבעית ורצונית" kvAspect="b11">
                            <outline text="פועלת במקרה בטבעיות">
                              <kvInfo kind="user" name="הגדרה">פועלת במקרה בטבעיות היא שפועלת לא מצד טבעה אלא מצד מקרה שקרה לה.</kvInfo>
                              <kvInfo kind="user" name="דוגמה">הניר הלבן מיגע הראיה מצד מקרה הלבן שבו.</kvInfo>
                              <kvInfo kind="user" name="מקור">פרק ד, כח</kvInfo>
                            </outline>
                            <outline text="פועלת במקרה בבחיריות">
                              <kvInfo kind="user" name="הגדרה">המקרית בבחיריות היא שפועלת שלא בכונה או בשגגה.</kvInfo>
                              <kvInfo kind="user" name="מקור">פרק ד, כט</kvInfo>
                            </outline>
                          </outline>
                        </outline>
                      </outline>
                      <outline kvDivision="yes" text="מולידה, מקימת ומפסדת" kvAspect="b12">
                        <outline text="המולידה">
                          <kvInfo kind="user" name="הגדרה">המולידה היא שמחדשת וממציאה המסבב</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כד</kvInfo>
                        </outline>
                        <outline text="המקימת">
                          <kvInfo kind="user" name="הגדרה">המקימת - שמתמדת אותו</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כד</kvInfo>
                        </outline>
                        <outline text="המפסדת">
                          <kvInfo kind="user" name="הגדרה">והמפסדת - שמבטלתו.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כד</kvInfo>
                        </outline>
                      </outline>
                      <outline kvDivision="yes" text="טבעית ורצונית" kvAspect="b11">
                        <outline text="הטבעית">
                          <kvInfo kind="user" name="הגדרה">הטבעית היא שפועלת מחמת טבעה בהכרח</kvInfo>
                          <kvInfo kind="user" name="דוגמה">שרפת האש פעלה טבעית שאי אפשר לו זולתה</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כה</kvInfo>
                        </outline>
                        <outline text="הרצונית (הבחיריית)">
                          <kvInfo kind="user" name="הגדרה">הרצונית - שפועלת מחמת עצה ובחירה, מה שאינה מכרחת.</kvInfo>
                          <kvInfo kind="user" name="דוגמה">כתיבת האדם - רצונית.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כה</kvInfo>
                        </outline>
                      </outline>
                      <outline kvDivision="yes" text="רחוקה, קרובה וסמוכה" kvAspect="b13">
                        <outline text="הסבה הרחוקה">
                          <kvInfo kind="user" name="הגדרה">בין הרחוקה והמסבב - אמצעיות הרבה</kvInfo>
                          <kvInfo kind="user" name="דוגמה">אברהם הוא סבה רחוקה לראובן</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כו</kvInfo>
                        </outline>
                        <outline text="הסבה הקרובה">
                          <kvInfo kind="user" name="הגדרה">בין הקרובה למסבב אחד</kvInfo>
                          <kvInfo kind="user" name="דוגמה">יצחק - סבה קרובה</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כו</kvInfo>
                        </outline>
                        <outline text="הסבה הסמוכה">
                          <kvInfo kind="user" name="הגדרה">בין הסמוכה והמסבב ולא כלום.</kvInfo>
                          <kvInfo kind="user" name="דוגמה">יעקב - סבה סמוכה.</kvInfo>
                          <kvInfo kind="user" name="כלל">כשתנח הסבה הסמוכה בפועל, מכרח שימצא המסבב בפועל, מה שאין כן ברחוקה ולא בקרובה.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ד, כו</kvInfo>
                        </outline>
                      </outline>
                    </outline>
                    <outline text="התכלית">
                      <kvInfo kind="user" name="הגדרה">התכליתית, והיא - שבעבורה סובב המסבב או נעשה הדבר</kvInfo>
                      <kvInfo kind="user" name="דוגמה">שנים מאריכין בתפלתן, אחד לשם שמים ואחד לגנב דעת הבריות שיאמינו לו; זה עושה מצוה רבה, וזה - אשם אשמה רבה.</kvInfo>
                      <kvInfo kind="user" name="כלל">התכלית מניע את הפועל לפעל.</kvInfo>
                      <kvInfo kind="user" name="כלל">בדבר אחד יכולים למצא תכליות רבים.</kvInfo>
                      <kvInfo kind="user" name="כלל">התכליות משנים הפעלות. (פרושו. כי פעלה אחת נעשית מפועל אחד לתכלית אחד ומפועל אחר לתכלית אחר יחשבו לפעלות שונות)</kvInfo>
                      <kvInfo kind="user" name="כלל">התכלית קודם לאמצעיים שלו במחשבה, מה שאין כן במעשה.</kvInfo>
                      <kvInfo kind="user" name="כלל">כשהתכלית הוה, כלתה הפעלה שנעשית להגיע אליו.</kvInfo>
                      <kvInfo kind="user" name="כלל">מי שרוצה באמת בתכלית, צריך שירצה באמצעיים. (פרושו, כי השגת התכלית בלי אמצעיים אי אפשר.)</kvInfo>
                      <kvInfo kind="user" name="מקור">פרק ה</kvInfo>
                      <outline kvDivision="yes" text="עקרי וטפל" kvAspect="b8">
                        <outline text="התכלית העקרי">
                          <kvInfo kind="user" name="הגדרה">העקרי הוא הכונה הראשונה של הפועל</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ה, א</kvInfo>
                        </outline>
                        <outline text="התכלית הטפל">
                          <kvInfo kind="user" name="הגדרה">הטפל הוא הכונה אשר לו מלבד הראשונה, במדרגה שניה אליה.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ה, א</kvInfo>
                        </outline>
                      </outline>
                      <outline kvDivision="yes" text="אחרון ואמצעי" kvAspect="b14">
                        <outline text="התכלית האחרון">
                          <kvInfo kind="user" name="הגדרה">האחרון כמשמעו - שדי לפועל בו</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ה, ב</kvInfo>
                        </outline>
                        <outline text="התכלית האמצעי">
                          <kvInfo kind="user" name="הגדרה">האמצעי - שהוא תכלית לדבר אחד, אך יהיה אמצעי להגיע עוד אל תכלית אחר שכון לו הפועל.</kvInfo>
                          <kvInfo kind="user" name="דוגמה">תכלית חכמת הרפואה הוא לדעת החלאים למיניהם בסבותיהם, אמנם התכלית האחרון הוא לרפא את החולים.</kvInfo>
                          <kvInfo kind="user" name="מקור">פרק ה, ב</kvInfo>
                        </outline>
                      </outline>
                    </outline>
                  </outline>
                  <outline text="הסבה הפנימית">
                    <kvInfo kind="user" name="הגדרה">הפנימית, הנכנסת במציאות המסובב עצמו, ומתחלק לשנים: חמר וצורה.</kvInfo>
                    <kvInfo kind="user" name="מקור">פרק ו, א</kvInfo>
                    <outline text="החמר">
